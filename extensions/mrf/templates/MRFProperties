%{%(mrfZonesPresent%)
%:True
%[_header%]
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      MRFProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// MRF zones generated by CfdOF MRF extension.
// Each entry corresponds to a CfdMRFZone object in the FreeCAD analysis.
// The zone name must match a cellZone defined in the mesh.
// Positive omega follows the right-hand rule w.r.t. the axis.

%{%(mrfZones%)
%(0%)
{
    cellZone        %(0%);

    active          yes;

    // Rotation axis origin [m]
    origin          (%(mrfZones/%(0%)/RotationOriginX%) %(mrfZones/%(0%)/RotationOriginY%) %(mrfZones/%(0%)/RotationOriginZ%));

    // Rotation axis unit vector
    axis            (%(mrfZones/%(0%)/RotationAxisX%) %(mrfZones/%(0%)/RotationAxisY%) %(mrfZones/%(0%)/RotationAxisZ%));

    // Angular velocity [rad/s]  (RPM * 2 * pi / 60, computed by case writer)
    omega           %(mrfZones/%(0%)/OmegaRadS%);

    // Patches inside this MRF zone that must remain stationary (e.g. shaft)
    nonRotatingPatches ( %(mrfZones/%(0%)/NonRotatingPatches%) );

}

%}
// ************************************************************************* //
%}
